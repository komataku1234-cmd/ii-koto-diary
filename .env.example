# このファイルをコピーして .env を作り、値を必要に応じて書き換えてください。
# cp .env.example .env

# アプリ(Prisma)が接続するDB。ローカルDocker用ならそのままでOK
DATABASE_URL="postgresql://postgres:postgres@ii-koto-diary-db:5432/ii_koto_diary"

# 管理者画面(/admin)ログイン用の固定パスワード。好きな値に変更してください
ADMIN_PASSWORD="changeme123"

# docker-compose.yml(dbサービス)がPostgreSQLコンテナ初期化時に使う値。
# DATABASE_URLの接続情報(ユーザー名・パスワード・DB名)と一致させること
# ローカル情報のため公開しても問題ない
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ii_koto_diary
